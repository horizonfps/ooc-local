{
  "name": "ooc-local",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && uv run uvicorn app.main:app --reload --port 8000",
    "dev:web": "cd frontend && npm run dev",
    "check": "npm run check:api && npm run check:web",
    "check:api": "cd backend && uv run pytest -q",
    "check:web": "cd frontend && npx tsc -b"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
